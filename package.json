{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/db-provider.mjs && prisma generate",
    "dev": "next dev --port 3000",
    "prebuild": "node scripts/db-provider.mjs && prisma generate",
    "build": "next build",
    "start": "next start --port 3000",
    "postinstall": "node scripts/db-provider.mjs && prisma generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run check:secrets",
    "check:secrets": "node scripts/pre-push-check.cjs",
    "setup": "node scripts/db-provider.mjs && prisma generate && prisma db push && prisma db seed",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset --accept-data-loss --skip-generate && prisma db seed",
    "db:provider": "node scripts/db-provider.mjs",
    "smoke": "node scripts/smoke.cjs",
    "perf": "node .audit/perf.cjs",
    "perf:wire": "node .audit/wire-audit.cjs",
    "perf:vitals": "node .audit/vitals.cjs",
    "perf:deferred": "node .audit/async-chunks.cjs",
    "perf:bundle": "node .audit/route-audit.cjs",
    "perf:serve": "node .audit/perf.cjs --keep"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^13.5.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "next": "15.5.27",
    "postprocessing": "^6.39.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "sharp": "^0.34.4",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prisma": "^6.19.3",
    "puppeteer-core": "^24.28.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
