# ---------------------------------------------------------------------------
# Copy to `.env` for local development, or paste each value into the Vercel
# project's Environment Variables. `.env` is gitignored — never commit it.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Local development: a SQLite file next to prisma/. No server required.
DATABASE_URL="file:./dev.db"

# Production (Vercel): use a POOLED connection string. Serverless functions
# create one connection per cold start, so a direct URL will exhaust the
# Postgres connection limit under load. Both Neon and Supabase expose a pooled
# URL; append ?pgbouncer=true (Neon) or use their "-pooler" hostname (Supabase).
# The host and credentials below are placeholders — paste your own from the
# provider dashboard.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.aws.neon.tech/nexus?sslmode=require"

# --- Auth -------------------------------------------------------------------
# Signs session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. The app refuses to boot in production without it.
AUTH_SECRET="dev-only-secret-change-me-nexus-marketplace-0123456789"

# --- App --------------------------------------------------------------------
# The deployed origin. No trailing slash. Used for metadata and absolute URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Payments ---------------------------------------------------------------
# "mock" simulates settlement locally. "evm" is the seam for a real relayer
# (see src/lib/payments/provider.ts).
PAYMENTS_PROVIDER="mock"
DEFAULT_CHAIN="base"

# Basis points. 800 = 8% platform fee.
PLATFORM_FEE_BPS="800"

# --- Cron -------------------------------------------------------------------
# Shared secret for GET /api/cron/trending, sent as the x-cron-secret header.
# Vercel Cron cannot set custom headers, so on Vercel leave this unset and rely
# on the platform schedule + deployment protection instead.
# CRON_SECRET="generate-a-long-random-string"

# --- Storage (not yet wired to a provider) ----------------------------------
# Where delivered archives live. Until this is set, /api/orders/[id]/file
# returns a generated licence manifest instead of the real archive.
# FILES_S3_BUCKET=""
# FILES_S3_REGION=""
# FILES_S3_ACCESS_KEY_ID=""
# FILES_S3_SECRET_ACCESS_KEY=""
